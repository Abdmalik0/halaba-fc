rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Halaba City FC Official Shop Products
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Official Club News & Articles
    match /news/{newsId} {
      allow read: if true;
      allow write: if true;
    }

    // Fallback default deny for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
