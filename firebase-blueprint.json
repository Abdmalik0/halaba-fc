{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Shop merchandise item, official kit, jersey, or club accessory",
      "type": "object",
      "properties": {
        "name": {
          "type": "object",
          "description": "Localized product title (en, am, om)"
        },
        "description": {
          "type": "object",
          "description": "Localized product description (en, am, om)"
        },
        "price": {
          "type": "number",
          "description": "Price in ETB (Ethiopian Birr)"
        },
        "imageUrl": {
          "type": "string",
          "description": "Product image URL or optimized data URI"
        },
        "availableSizes": {
          "type": "array",
          "description": "Array of available apparel sizes"
        },
        "category": {
          "type": "string",
          "enum": ["JERSEY", "KIT", "ACCESSORY"],
          "description": "Item category"
        },
        "inStock": {
          "type": "boolean",
          "description": "Inventory stock availability flag"
        },
        "featured": {
          "type": "boolean",
          "description": "Whether the product is highlighted on the shop page"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when product was created"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when product was last modified"
        }
      },
      "required": ["name", "price", "imageUrl"]
    },
    "News": {
      "title": "News",
      "description": "Club news articles and announcements",
      "type": "object",
      "properties": {
        "title": { "type": "object", "description": "Localized title" },
        "summary": { "type": "object", "description": "Localized short summary" },
        "content": { "type": "object", "description": "Full article body" },
        "category": { "type": "string", "description": "News category" },
        "date": { "type": "string", "description": "Publication date" },
        "author": { "type": "string", "description": "Author name" },
        "imageUrl": { "type": "string", "description": "Hero photo URL" },
        "readTime": { "type": "string", "description": "Estimated reading duration" }
      },
      "required": ["title", "content"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Stores shop merchandise items for Halaba City FC"
    },
    "/news/{newsId}": {
      "schema": "News",
      "description": "Stores official club news articles"
    }
  }
}
